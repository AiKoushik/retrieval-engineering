root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 76

[Makefile]
indent_style = tab

[*.{yml,yaml,toml,json,cff}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[sample/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
